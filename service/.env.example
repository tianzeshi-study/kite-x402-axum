# Copy to `.env` and fill in the blanks. `cargo run` loads `.env` automatically
# (variables already set in the environment win). Values with spaces must stay
# quoted so `set -a && source .env && set +a` also works.

# --- required -----------------------------------------------------------------
# Wallet that receives the payments.
PAY_TO=0xYourKiteWalletAddress
# The API being wrapped (origin, optionally with a base path; no trailing slash).
# Requests for /v1/<path> are forwarded to <UPSTREAM_URL>/<path>.
UPSTREAM_URL=https://api.example.com

# --- optional (defaults shown) ---------------------------------------------------
# Price per call in USD; "0.001" and "$0.001" are both accepted.
PRICE_USD=0.001
# "mainnet" or "testnet".
KITE_NETWORK=mainnet
PORT=8402
FACILITATOR_URL=https://facilitator.pieverse.io/v2
SERVICE_DESCRIPTION="Paid API access via Kite x402"

# Credential injected into every upstream request and never shown to the buyer.
# Leave UPSTREAM_AUTH_VALUE empty to inject nothing.
UPSTREAM_AUTH_HEADER=Authorization
UPSTREAM_AUTH_VALUE=

# Log filter, e.g. info | debug | kite_x402_service=debug,kite_x402_axum=debug
RUST_LOG=info
