# Copy this file to .env and fill in the values, or export them in your
# shell / deployment platform. Same variable names as the Go and TypeScript
# templates in this repository.

# Required: the wallet address that receives payment.
PAY_TO=0xYourWalletAddressHere

# Required: the upstream API this wrapper protects. Requests to
# /v1/<path> are forwarded to <UPSTREAM_URL>/<path> after payment settles.
UPSTREAM_URL=https://api.example.com

# mainnet or testnet. Defaults to mainnet. Use testnet while developing —
# it settles in pieUSD test tokens instead of real USDC.e.
KITE_NETWORK=testnet

# Price per call, as a plain USD decimal (optionally "$"-prefixed).
# Defaults to 0.001. Must not have more fractional digits than the
# network's stablecoin (6 for mainnet USDC.e, 18 for testnet pieUSD).
PRICE_USD=0.001

# Header + value injected into the request forwarded upstream (e.g. your
# own API key for UPSTREAM_URL). Leave UPSTREAM_AUTH_VALUE empty to inject
# nothing.
UPSTREAM_AUTH_HEADER=Authorization
UPSTREAM_AUTH_VALUE=

# The x402 facilitator that verifies and settles payments. Defaults to
# Kite's production facilitator; only override this for local testing
# against a mock facilitator.
FACILITATOR_URL=https://facilitator.pieverse.io/v2

# Shown to buyers as the resource description in the 402 challenge.
SERVICE_DESCRIPTION=Paid API access via Kite x402

# Port to listen on. Defaults to 8402.
PORT=8402
